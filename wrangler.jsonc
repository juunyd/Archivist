{
	"name": "archivist",
	"compatibility_date": "2026-09-18",
	// The Worker script is now the entry point for every request (needed for
	// /api/* below); it serves everything else itself via env.ASSETS.fetch(),
	// which is why "assets" needs a binding name now, not just a directory.
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	// Non-secret config the Worker reads at runtime. The Razorpay/Resend
	// secrets are NOT here — set with `wrangler secret put <NAME>` instead,
	// same as they were Supabase Edge Function secrets before.
	"vars": {
		"SITE_URL": "https://archivist.in",
		"EMAIL_FROM": "Archivist <noreply@archivist.in>",
		// Cloudflare Access config for verifying /api/admin/* requests (see
		// worker/lib/access.ts). Not secrets, but fill these in with your real
		// values before deploying — every admin route 500s until they're set.
		// CF_ACCESS_TEAM_DOMAIN: Zero Trust dashboard -> Settings -> Custom Pages
		// (or the URL bar on your team's Access login page), e.g.
		// "yourteam.cloudflareaccess.com".
		// CF_ACCESS_AUD: the /admin Access application's Overview tab -> "Application Audience (AUD) Tag".
		// See ADMIN.md for the full setup walkthrough.
		"CF_ACCESS_TEAM_DOMAIN": "autumn-snow-fc56.cloudflareaccess.com",
		"CF_ACCESS_AUD": "571be00718dd48f8043e00a92cbcef8ca24aa922c7f775ae21d2843367ab9aff"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "archivist-db",
			"database_id": "cf2a9b97-fbec-42ac-95be-d3bbdaf63e15",
			"migrations_dir": "./migrations"
		}
	],
	// Private bucket holding the deliverable PDFs, keyed {slug}/{slug}.pdf
	// (mirrors books.pdf_path). R2 buckets have no public access and no
	// signed-URL exposure here. The download route (Phase 3) streams the
	// object through the Worker after validating the caller's token.
	"r2_buckets": [
		{
			"binding": "BOOK_FILES",
			"bucket_name": "archivist-book-files"
		}
	]
}