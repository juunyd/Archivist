# Copy this file to .env.local for local development, and set the same
# keys in the Cloudflare project settings for production/preview.
#
# Every value here is public: NEXT_PUBLIC_* variables are inlined into the
# static export at build time and shipped to every visitor's browser.
# Never put a secret key (Razorpay key SECRET, Supabase service_role key,
# Resend API key, etc.) in a NEXT_PUBLIC_ variable or anywhere in this
# repo — those belong only in Supabase Edge Function secrets.

# Canonical site URL, used for metadata/Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://archivist.in

# Supabase project URL and anon (public) key. The anon key is safe to
# expose client-side; row-level security policies do the real access
# control on the Supabase side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Razorpay needs no variable here: create-order returns the publishable key
# id alongside the order, so the browser learns it at checkout time and the
# Razorpay secret never comes near this project.
