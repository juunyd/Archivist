# Copy this file to .env.local for local development, and set the same
# key in the Cloudflare project settings for production/preview.
#
# The value here is public: NEXT_PUBLIC_* variables are inlined into the
# static export at build time and shipped to every visitor's browser.
# Never put a secret (Razorpay key SECRET, Resend API key, webhook signing
# secret, etc.) in a NEXT_PUBLIC_ variable or anywhere in this repo — those
# are Worker secrets, set with `wrangler secret put <NAME>`, never a build
# var. See DEPLOY.md.

# Canonical site URL, used for metadata/Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://archivist.in

# Nothing else belongs here. The frontend talks to the backend over
# same-origin /api/* routes on the Worker (see worker/) — there is no
# separate backend URL or public API key for the browser to know about.
